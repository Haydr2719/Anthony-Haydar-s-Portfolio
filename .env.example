# ---------------------------------------------------------------------------
# Copy this file to .env (or .env.local) and fill in the values.
# NEVER put real keys in this file - it is committed to a public git repo.
# The site runs WITHOUT Supabase (it shows built-in placeholder content),
# but the admin CMS and the enquiry form need Supabase configured.
# Restart the dev server after changing any value.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> Data API (URL) and API Keys (the two keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_...). SERVER ONLY - never prefix with NEXT_PUBLIC_.
# Used to store enquiries and banner clicks after spam checks, and to send push notifications.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for SEO, sitemap, social cards). Use http://localhost:3000 for local-only testing.
NEXT_PUBLIC_SITE_URL=https://anthonyhaydar.com/

# Browser push notifications for new enquiries.
# Generate once with:  npx web-push generate-vapid-keys
# Use the SAME keys everywhere (changing them disconnects every device).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address for the push services, written as mailto:you@domain (no space after the colon).
VAPID_SUBJECT=mailto:consultancy@anthonyhaydar.com

# Contact details for the "temporarily unavailable" page. They live here (not in the
# database) so visitors can still reach Anthony if the database is down.
NEXT_PUBLIC_CONTACT_EMAIL=consultancy@anthonyhaydar.com
# Optional: WhatsApp number, international format (e.g. +96170151219).
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Optional: email notification for every new enquiry (https://resend.com)
# Without your own domain: register Resend with the SAME Gmail you put in
# LEAD_NOTIFY_EMAIL and leave LEAD_FROM_EMAIL empty (sends from onboarding@resend.dev).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=

# Optional: Cloudflare Turnstile spam protection (honeypot + rate limit are always on)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: analytics (only loaded after the visitor accepts cookies)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
