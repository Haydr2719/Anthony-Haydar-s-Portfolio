# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# The site runs WITHOUT Supabase (it shows built-in placeholder content),
# but the admin CMS and the enquiry form need Supabase configured.
# ---------------------------------------------------------------------------

# Public site URL (used for SEO, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tmyeyrhrvapmpoazfadl.supabase.co
# The "publishable" key (or legacy "anon" key). Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRteWV5cmhydmFwbXBvYXpmYWRsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE1NTA5NTMsImV4cCI6MjEwNzEyNjk1M30.HFIndRUvIYxZ-jzD6OFhbBFSc8nx0i63uqUBBS-hPME
# The "secret" key (or legacy "service_role" key). SERVER ONLY - never prefix with NEXT_PUBLIC_.
# Used to store enquiries and banner clicks after spam checks.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRteWV5cmhydmFwbXBvYXpmYWRsIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTU1MDk1MywiZXhwIjoyMTA3MTI2OTUzfQ.RAKtwjGnDpx7fYIBziOCKQww_3r6cOT_ftfA726YBIs

# Contact details for the "temporarily unavailable" page. They live here (not in the
# database) so visitors can still reach Anthony if the database is down.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Browser push notifications for new enquiries.
# Generate once with:  npx web-push generate-vapid-keys
# Use the SAME keys everywhere (changing them disconnects every device).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@gmail.com

# Optional: email notification for every new enquiry (https://resend.com)
# Without your own domain: register Resend with the SAME Gmail you put in
# LEAD_NOTIFY_EMAIL and leave LEAD_FROM_EMAIL empty (sends from onboarding@resend.dev).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=

# Optional: Cloudflare Turnstile spam protection (honeypot + rate limit are always on)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: analytics (only loaded after the visitor accepts cookies)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
